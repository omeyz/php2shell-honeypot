# Copy to honeypot.env and fill in. Sourced by render-nftables.sh and watchdog.sh.
# On a single-NIC host (GCP, and most clouds) set BOTH to the same name,
# e.g. ens4. The ruleset discriminates by address, not interface, so this is
# only used for masquerade and for the public-side match.
PUB_IF=ens4              # gateway public interface
PRIV_IF=ens4             # gateway private interface (Hetzner: ens10, DO: eth1)
GW_IP=10.99.0.2          # the gateway's OWN private IP (DNAT keys on this)
                         # note: GCP reserves x.x.x.1 as the subnet gateway
HONEY_IP=10.99.0.10      # honeypot private IP
PRIV_CIDR=10.99.0.0/24
# YOUR admin IP ONLY. Never 0.0.0.0/0. This file is SOURCED by the gateway
# scripts, so a multi-value set MUST be quoted or the braces become a shell
# brace-group and every script that sources this file dies -- including the
# watchdog that holds the disk guard and the egress kill switch:
#   ADMIN_CIDR='{ 35.235.240.0/20, 203.0.113.4/32 }'
# Allowing Google's IAP range (35.235.240.0/20) is worth it on GCP: admin
# access then survives your home IP changing, and reaching the box through it
# still requires IAM auth.
ADMIN_CIDR=203.0.113.4/32
SSH_PORT=22022
RESOLVER=1.1.1.1
# Watchdog: trip the kill switch if honeypot egress exceeds this in one window.
EGRESS_BYTES_PER_MIN=5000000
# Trip the kill switch if the capture disk drops below this much free space.
DISK_MIN_FREE_BYTES=1000000000
# Byte budget for the pcap directory. Oldest captures are pruned above it.
PCAP_MAX_BYTES=4000000000
